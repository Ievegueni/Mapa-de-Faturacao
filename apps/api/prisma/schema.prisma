// Schema da Plataforma de Controlo de Facturação (ver CLAUDE.md §6).
// Os modelos são acrescentados sprint a sprint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GESTOR
  SUPERVISOR
  TECNICO
}

enum BillingType {
  PROVIDERS
  GERADORES
}

enum InvoiceStatus {
  ABERTO
  ANDAMENTO
  PENDENTE
  FECHADO
}

enum RecordState {
  RASCUNHO
  SUBMETIDO
  VALIDADO
  FECHADO
}

model User {
  id                  String                 @id @default(cuid())
  nome                String
  email               String                 @unique
  passwordHash        String
  role                Role
  ativo               Boolean                @default(true)
  mustChangePassword  Boolean                @default(true)
  teams               TeamMember[]
  permissionOverrides UserPermission[]
  createdAt           DateTime               @default(now())
  invoicesCreated     ProviderInvoice[]      @relation("InvoiceCreatedBy")
  invoicesValidated   ProviderInvoice[]      @relation("InvoiceValidatedBy")
  measurements        GeneratorMeasurement[]
  mapsClosed          GeneratorMonthlyMap[]
}

model Team {
  id            String                @id @default(cuid())
  nome          String                @unique
  tipo          BillingType
  ativo         Boolean               @default(true)
  members       TeamMember[]
  budgets       ProviderBudget[]
  invoices      ProviderInvoice[]
  sites         Site[]
  generatorMaps GeneratorMonthlyMap[]
}

model TeamMember {
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

model UserPermission {
  userId  String
  module  String
  action  String
  allowed Boolean
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module, action])
}

// ---------- Página única de providers ----------

model Provider {
  id            String                @id @default(cuid())
  nome          String                @unique
  nif           String?
  contacto      String?
  email         String?
  tipos         BillingType[]
  ativo         Boolean               @default(true)
  budgets       ProviderBudget[]
  priceTables   PriceTable[]
  targets       Target[]
  invoices      ProviderInvoice[]
  generators    Generator[]
  generatorMaps GeneratorMonthlyMap[]
}

/// PO e orçamento mensal por provider/equipa/ano. teamId vazio = aplica-se a todas as equipas
/// (valor por omissão; uma linha da equipa sobrepõe-se). Índice único parcial na migração.
model ProviderBudget {
  id                  String   @id @default(cuid())
  providerId          String
  teamId              String?
  ano                 Int
  po                  String?
  orcamentoMensalCent BigInt?
  provider            Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  team                Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([providerId, teamId, ano])
  @@index([ano])
}

/// Preços — TODOS os valores podem ficar em branco e ser preenchidos na ferramenta.
model PriceTable {
  id                   String      @id @default(cuid())
  providerId           String
  validFrom            DateTime    @db.Date
  precoCombustivelCent BigInt?
  precoServAbastCent   BigInt?
  precoManutencaoCent  BigInt?
  ivaPercent           Decimal?    @db.Decimal(5, 2)
  provider             Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rentPrices           RentPrice[]

  @@unique([providerId, validFrom])
}

/// Preço de aluguer por dia (linhas criadas e editadas na UI).
model RentPrice {
  id           String     @id @default(cuid())
  priceTableId String
  potenciaKVA  Int?
  subtipo      String? /// vazio = aplica-se a todos
  distancia    String? /// vazio = aplica-se a todas
  precoDiaCent BigInt?
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)

  @@index([priceTableId])
}

/// Faixas de desconto da rede (horas de rede por dia → %), editáveis na UI.
model GridDiscountRule {
  id        String   @id @default(cuid())
  horasMin  Int
  horasMax  Int
  percent   Decimal  @db.Decimal(5, 2)
  validFrom DateTime @db.Date

  @@index([validFrom])
}

/// Targets — providerId vazio = target GLOBAL. Índice único parcial para o global na migração.
model Target {
  id              String    @id @default(cuid())
  ano             Int
  mes             Int
  providerId      String?
  aluguerCent     BigInt?
  combustivelCent BigInt?
  provider        Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([ano, mes, providerId])
}

// ---------- PROVIDERS (modelo actual) ----------

model ProviderInvoice {
  id             String        @id @default(cuid())
  teamId         String
  providerId     String
  ano            Int
  mes            Int
  /// PO preenchido automaticamente a partir do orçamento (equipa → por omissão) e guardado com a factura.
  po             String?
  tipo           String /// Manutenção | Material
  numeroFactura  String?
  dataFacturacao DateTime?     @db.Date
  dataExecucao   DateTime?     @db.Date
  qtdOTs         Int?
  consumiveis    Int?
  valorFTCent    BigInt
  valorPagoCent  BigInt        @default(0)
  status         InvoiceStatus @default(ABERTO)
  observacao     String?
  state          RecordState   @default(RASCUNHO)
  createdById    String
  validatedById  String?
  validatedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  team           Team          @relation(fields: [teamId], references: [id])
  provider       Provider      @relation(fields: [providerId], references: [id])
  createdBy      User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  validatedBy    User?         @relation("InvoiceValidatedBy", fields: [validatedById], references: [id])

  @@index([teamId, ano, mes])
  @@index([providerId, ano])
  @@index([createdById, state])
}

// ---------- GERADORES ----------

model Site {
  id                  String                 @id @default(cuid())
  codigoPP            String?
  codigoLocalizacao   String?
  codigoCliente       String?
  nome                String
  regiao              String /// normalizado: Norte|Centro|Sul|Leste
  provincia           String
  nivel               String?
  tipo                String?
  powerCube1000       Boolean?
  subtipo             String?
  distanciaFacturacao String?
  tipoAcesso          String?
  pavimentadoInterior Boolean?
  ligadoRede          Boolean?
  teamId              String
  team                Team                   @relation(fields: [teamId], references: [id])
  generators          Generator[]
  measurements        GeneratorMeasurement[]

  /// O código P.P. não é único: há sites diferentes com o mesmo código no Auto de Medição real.
  @@index([teamId, codigoPP])
  @@index([teamId, regiao])
  @@index([nome])
}

model Generator {
  id             String                 @id @default(cuid())
  siteId         String
  providerId     String /// Proprietário
  numeroSerie    String                 @unique
  numeroActivo   String?
  potenciaKVA    Int?
  dataInstalacao DateTime?              @db.Date
  dataRemocao    DateTime?              @db.Date
  dataEntrada    DateTime?              @db.Date
  site           Site                   @relation(fields: [siteId], references: [id])
  provider       Provider               @relation(fields: [providerId], references: [id])
  measurements   GeneratorMeasurement[]

  @@index([siteId])
  @@index([providerId])
}

/// Um mapa por equipa/provider/mês.
model GeneratorMonthlyMap {
  id           String                 @id @default(cuid())
  teamId       String
  providerId   String
  ano          Int
  mes          Int
  state        RecordState            @default(RASCUNHO)
  closedById   String?
  closedAt     DateTime?
  createdAt    DateTime               @default(now())
  team         Team                   @relation(fields: [teamId], references: [id])
  provider     Provider               @relation(fields: [providerId], references: [id])
  closedBy     User?                  @relation(fields: [closedById], references: [id])
  measurements GeneratorMeasurement[]
  indicators   MonthlyIndicators?

  @@unique([teamId, providerId, ano, mes])
}

/// Uma linha do Auto de Medição.
model GeneratorMeasurement {
  id                   String              @id @default(cuid())
  mapId                String
  siteId               String
  generatorId          String
  dias                 Int
  horasN1              Decimal?            @db.Decimal(12, 2)
  horasN               Decimal?            @db.Decimal(12, 2)
  litros               Decimal?            @db.Decimal(12, 2)
  // snapshot dos preços aplicados (vazio se ainda não definidos)
  precoCombustivelCent BigInt?
  precoServAbastCent   BigInt?
  precoAluguerDiaCent  BigInt?
  precoManutencaoCent  BigInt?
  // valores manuais — ficam em branco até serem preenchidos
  servExtrasCent       BigInt?
  penExcessoHorasCent  BigInt?
  penSLACent           BigInt?
  penNivelCombustCent  BigInt?
  penAvariaCent        BigInt?
  // calculados (persistidos para relatórios rápidos)
  horasTrabalhadas     Int?
  horasRede            Int?
  descontoPercent      Decimal?            @db.Decimal(5, 2)
  combustivelCent      BigInt
  servAbastCent        BigInt
  abastecimentoCent    BigInt
  aluguerCent          BigInt
  descontoRedeCent     BigInt
  totalCent            BigInt
  flags                String[]
  state                RecordState         @default(RASCUNHO)
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  map                  GeneratorMonthlyMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  site                 Site                @relation(fields: [siteId], references: [id])
  generator            Generator           @relation(fields: [generatorId], references: [id])
  createdBy            User                @relation(fields: [createdById], references: [id])

  @@unique([mapId, generatorId])
  @@index([siteId])
  @@index([generatorId])
}

/// Linhas manuais do Mapa Resumo de Validações.
model MonthlyIndicators {
  id                          String              @id @default(cuid())
  mapId                       String              @unique
  sitesRedePublica            Int?
  sitesRedeConfiguradosNetEco Int?
  sitesRedeSemGarantia        Int?
  poupancaCent                BigInt?
  transporteExtraCent         BigInt?
  /// Valores da factura do provider (opcionais): quando preenchidos, a Diferença do Resumo do mês = factura − validado.
  factAluguerLuandaCent       BigInt?
  factAluguerProvinciaCent    BigInt?
  factCombustivelLuandaCent   BigInt?
  factCombustivelProvinciaCent BigInt?
  factServAbastLuandaCent     BigInt?
  factServAbastProvinciaCent  BigInt?
  map                         GeneratorMonthlyMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  entity    String
  entityId  String
  action    String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}
