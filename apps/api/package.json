{
  "name": "@cf/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=16.13 <17"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:demo": "ts-node --transpile-only prisma/seed-demo.ts",
    "test": "vitest run",
    "import:providers": "ts-node --transpile-only scripts/import-providers.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@cf/shared": "0.1.0",
    "@fastify/cookie": "9.4.0",
    "@fastify/jwt": "7.2.4",
    "@fastify/multipart": "8.3.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "fastify": "4.29.1",
    "fastify-plugin": "4.5.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "16.18.126",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "0.34.6"
  }
}
