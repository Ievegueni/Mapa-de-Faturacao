{
  "name": "controlo-facturacao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16.13 <17"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w packages/shared -w apps/api -w apps/web",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "seed:demo": "npm run build -w packages/shared && npm run seed:demo -w apps/api",
    "test": "npm run test -w packages/shared -w apps/api"
  },
  "overrides": {
    "node-releases": "2.0.44",
    "postcss-load-config": "4.0.2",
    "toad-cache": "3.7.0"
  }
}
